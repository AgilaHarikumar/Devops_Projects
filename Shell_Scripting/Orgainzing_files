#!/bin/bash

# Step 1: Define the source directory
SOURCE="myfiles"

# Step 2: Check whether the source directory exists
if [ ! -d "$SOURCE" ]; then
    echo "ERROR: Source directory does not exist."
    exit 1
fi

# Step 3: Process each item in the source directory
for file in "$SOURCE"/*; do

    # Skip directories and process files only
    if [ ! -f "$file" ]; then
        continue
    fi

    # Step 4: Extract the filename
    filename="${file##*/}"

    # Step 5: Identify the file extension
    if [[ "$filename" == *.* && "$filename" != .* ]]; then
        extension="${filename##*.}"
    else
        extension="no_extension"
    fi

    # Step 6: Create the destination directory
    destination="$SOURCE/$extension"
    mkdir -p "$destination"

    # Step 7: Move the file into the destination directory
    if mv -n -- "$file" "$destination/"; then
        echo "Moved $filename to $destination/"
    else
        echo "ERROR: Could not move $filename"
    fi

done

echo "File organization completed!"
